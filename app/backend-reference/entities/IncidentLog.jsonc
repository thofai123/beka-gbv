{
  "name": "IncidentLog",
  "type": "object",
  "properties": {
    "who_perpetrator": {
      "type": "string",
      "description": "Who committed the act (name/description/relationship)"
    },
    "who_witnesses": {
      "type": "string",
      "description": "Any witnesses present"
    },
    "what_happened": {
      "type": "string",
      "description": "Detailed description of what occurred"
    },
    "what_injuries": {
      "type": "string",
      "description": "Physical injuries or harm sustained"
    },
    "when_date": {
      "type": "string",
      "description": "Date of incident"
    },
    "when_time": {
      "type": "string",
      "description": "Approximate time of incident"
    },
    "where_location": {
      "type": "string",
      "description": "Location / address of incident"
    },
    "where_province": {
      "type": "string",
      "enum": [
        "Lusaka",
        "Copperbelt",
        "Central",
        "Eastern",
        "Northern",
        "Luapula",
        "Western",
        "Southern",
        "North-Western",
        "Muchinga"
      ],
      "description": "Zambian province"
    },
    "prior_incidents": {
      "type": "string",
      "description": "Previous incidents if any"
    },
    "police_report_number": {
      "type": "string",
      "description": "ZP Form 32 / police ref number if available"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "finalized",
        "exported"
      ],
      "default": "draft"
    },
    "linked_case_id": {
      "type": "string"
    }
  },
  "required": [
    "what_happened",
    "when_date",
    "where_location"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}