# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/beka"

# Secret used to sign JWTs — set a long random value in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

PORT=8080
NODE_ENV=production

# Comma-separated list of allowed browser origins (app + landing).
# Leave empty to allow all (dev only).
CORS_ORIGINS="https://app.your-domain.com,https://your-domain.com"

# SMS via Africala / SMSala. If unset, SMS is logged and skipped.
AFRICALA_API_TOKEN=""
SMS_SENDER_ID="AlaTech"

# Optional LLM provider for GBV risk assessment. If unset, returns a safe default.
LLM_PROVIDER=""

# File uploads (evidence vault)
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE="/uploads"
MAX_UPLOAD_BYTES=26214400

# Seed admin (used by npm run db:seed)
SEED_ADMIN_EMAIL="admin@beka.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
